<main class="stage">
  <section class="card">
    <h1><%= @title %></h1>
    <p class="lede"><%= @message %></p>
    <% if @authenticated %>
      <form method="post" action="/_sserve/logout">
        <%== csrf_tag("/_sserve/logout") %>
        <button class="text-button" type="submit">Sign Out</button>
      </form>
    <% end %>
  </section>
</main>
